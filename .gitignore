# ================= Dependencies =================
node_modules/
# NOTE: package-lock.json is intentionally TRACKED (reproducible installs)

# ================= Python =================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
ENV/
pip-wheel-metadata/

# ================= Build outputs =================
dist/
dist-ssr/
build/
*.local

# ================= Logs =================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ================= Env & secrets =================
# Ignore real env files at any level, but KEEP tracked examples:
#   backend/.env          -> ignored (your keys, never commit)
#   backend/.env.example  -> tracked (safe template for others)
.env
**/.env
!**/.env.example
.env.local
.env.*.local

# ================= SQLite dev database =================
# Local file DB, regenerated by init_db() + seed_demo.py. Never commit.
backend/construction.db
backend/construction.db-*
*.sqlite
*.sqlite3

# ================= Generated site evidence =================
# Annotated vision frames / uploads are runtime artifacts, not source.
backend/static/frames/
backend/static/uploads/

# ================= BuildSafe Vision weights (large binaries, versioned separately) =================
backend/models/*.pt
backend/models/*.onnx

# ================= Playwright E2E artifacts =================
playwright-report/
test-results/
artifacts/

# ================= Coverage =================
coverage/
.nyc_output/

# ================= OS / Editor =================
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
