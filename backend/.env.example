# Copy to .env and fill in. The backend reads this file on startup.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-PASTE_YOUR_KEY_HERE
# Any OpenRouter model id, e.g. openai/gpt-4o-mini, anthropic/claude-3.5-haiku
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional: server-side voice transcription fallback.
# DEFAULT (no key needed): offline faster-whisper on this server.
# Set OPENAI_API_KEY only to prefer the hosted Whisper API instead.
# OPENAI_API_KEY=
# Offline model size: tiny < base (default) < small < medium.
# WHISPER_MODEL=base

# --- BuildSafe Vision (YOLOv8) ---
# Absolute or relative path to PPE weights. Versioned file, e.g. backend/models/ppe-yolov8s-v1.pt
# If missing/unloadable the API fail-safes to legacy HOG+HSV and flags method=legacy/degraded=true.
YOLO_MODEL_PATH=backend/models/ppe-yolov8s-v1.pt
YOLO_CONF=0.25
YOLO_IOU=0.45
YOLO_IMGSZ=640
